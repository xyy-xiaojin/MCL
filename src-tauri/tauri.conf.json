{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCL",
  "version": "0.0.3",
  "identifier": "com.mcl.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MCL",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#0a0910",
        "additionalBrowserArgs": "--disable-gpu-sandbox --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/netplay/*"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
